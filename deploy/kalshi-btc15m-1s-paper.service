[Unit]
Description=Kalshi BTC strategy replay worker (one-shot template)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/matt/workspace/kalshi-btc-15m-bot
ExecStart=/home/matt/workspace/kalshi-btc-15m-bot/.venv/bin/kbtc-replay --feed-db feed/kalshi-btc-1s.sqlite3 --runs-dir runs --strategy simple_directional
StandardOutput=append:/home/matt/workspace/kalshi-btc-15m-bot/logs/replay.log
StandardError=append:/home/matt/workspace/kalshi-btc-15m-bot/logs/replay.log

# Safety: replay reads the feed DB and writes immutable run outputs. It does not
# load Kalshi credentials and has no live order adapter.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/matt/workspace/kalshi-btc-15m-bot/runs /home/matt/workspace/kalshi-btc-15m-bot/logs

[Install]
WantedBy=default.target
