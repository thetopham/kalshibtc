[Unit]
Description=Kalshi BTC read-only 1s feed recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/matt/workspace/kalshi-btc-15m-bot
ExecStart=/home/matt/workspace/kalshi-btc-15m-bot/.venv/bin/kbtc-feed --snapshot-db feed/kalshi-btc-1s.sqlite3 --loop --emit-min-interval-seconds 1
Restart=always
RestartSec=10
StandardOutput=append:/home/matt/workspace/kalshi-btc-15m-bot/logs/feed.log
StandardError=append:/home/matt/workspace/kalshi-btc-15m-bot/logs/feed.log

# Safety: read-only public-data/feed recorder. It writes local SQLite snapshots and has no order-submission path.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/matt/workspace/kalshi-btc-15m-bot/feed /home/matt/workspace/kalshi-btc-15m-bot/logs

[Install]
WantedBy=default.target
