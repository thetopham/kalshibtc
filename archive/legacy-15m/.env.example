# Do not put live Kalshi credentials in source control.
# Copy this file to .env for local development; .env is gitignored.

# Optional: point CLI at a different config file.
KALSHI_BTC15M_CONFIG=configs/default.toml

# Optional: override local data directory only for configs that omit data_dir.
# Live configs set their own data_dir so paper/demo/live ledgers stay isolated.
# KALSHI_BTC15M_DATA_DIR=data

# Required only for configs with trading_mode="live" and enable_live_orders=true.
# Store the private key outside the repo and chmod 600 it first, e.g.:
#   mkdir -p ~/.config/kalshibtc
#   mv kalshi-api-key.key ~/.config/kalshibtc/kalshi-demo.key
#   chmod 600 ~/.config/kalshibtc/kalshi-demo.key
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_FILE=$HOME/.config/kalshibtc/kalshi-demo.key
